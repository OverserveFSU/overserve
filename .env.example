# OverServe — environment template.
# Copy to .env, fill in your values, then load it:   set -a; source .env; set +a
# .env is git-ignored. NEVER commit real keys. See SETUP.md for details.

# ── 2a. Advanced LLMs: attack writer / fusion / stealth judge (REQUIRED) ──────────────
# OpenAI-compatible gateway (OpenRouter by default). config.require_key() aborts if KEY unset.
OPENROUTER_API_KEY=            # <-- your key (required)
OPENROUTER_URL=https://openrouter.ai/api/v1
OVERSERVE_GENERATOR_MODEL=anthropic/claude-sonnet-4     # writer/judge (e.g. z-ai/glm-5.3-flash)
OVERSERVE_FUSION_MODEL=deepseek/deepseek-v4-flash-0731  # task-fusion model

# ── 2b. Victim agent: the SaaS agent under attack (REQUIRED for rollouts) ──────────────
# Any OpenAI-compatible chat endpoint (local vLLM, tunnel, or cloud).
EOG_LLM_ENDPOINT=http://127.0.0.1:8192/v1
EOG_LLM_KEY=                   # <-- victim endpoint bearer (set even if server ignores it)
EOG_LLM_MODEL=qwen3.8-27b      # e.g. deepseek-v4-flash, nemotron-3-super
# qwen: disable thinking (send chat_template_kwargs enable_thinking=false, or front with
#   detectors/llm_proxy.py on :8193). deepseek/nemotron: standard parse, set max_output_tokens=16384.
# Per-benchmark victim model ids (optional; default to the victim above):
MCPMARK_MODEL=qwen3.8-27b
WB_QWEN_MODEL_ID=qwen3.8-27b

# EOG gym location (only if not at the default path):
# EOG_HOME=/path/to/EnterpriseOps-Gym
# EOG_PYTHON=/path/to/EnterpriseOps-Gym/.venv/bin/python
# EOG_LLM_CFG=/path/to/EnterpriseOps-Gym/conf/llm/qwen35.json

# ── 2c. Bedrock models: frontier victim (Sonnet-5) or GPT judges (OPTIONAL) ────────────
# Put the token in a file and load it; front Bedrock with the OpenAI-compat shim, then point
# EOG_LLM_ENDPOINT at the shim's local port (e.g. http://127.0.0.1:8300/v1) with a route model id.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1

# ── 2d. Run knobs (OPTIONAL; sensible defaults) ───────────────────────────────────────
ATK_CAP=200          # max agent turns per rollout
ATK_CHURN=1          # 1 = production churn (amplify); 0 = quiescent audit (benign)
# ATK_BUDGET=16      # search budget (candidates)
# REPS=3             # repetitions
# OVERSERVE_SEED=0   # RNG seed
